{
  "name": "collabmd",
  "version": "0.1.51",
  "type": "module",
  "description": "Collaborative markdown vault — like Obsidian, but online. Serve any directory of markdown files for realtime collaborative editing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andes90/collabmd.git"
  },
  "homepage": "https://github.com/andes90/collabmd#readme",
  "bugs": {
    "url": "https://github.com/andes90/collabmd/issues"
  },
  "files": [
    "README.md",
    "bin/",
    "dist/",
    "docker-compose.yml",
    "scripts/cloudflare-tunnel.mjs",
    "scripts/local-plantuml-compose.mjs",
    "scripts/local-structurizr-compose.mjs",
    "src/"
  ],
  "bin": {
    "collabmd": "./bin/collabmd.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "vite build",
    "capture:readme-assets": "node scripts/capture-readme-assets.mjs",
    "check": "npm run lint && npm run test:guardrails && npm run test:unit && npm run test:integration:prebuilt && npm run test:browser",
    "dev:client": "vite",
    "dev:server": "node bin/collabmd.js --no-tunnel",
    "homebrew:formula": "node scripts/render-homebrew-formula.mjs",
    "lint": "eslint .",
    "plantuml:up": "node scripts/local-plantuml-compose.mjs up",
    "plantuml:down": "node scripts/local-plantuml-compose.mjs down",
    "structurizr:up": "node scripts/local-structurizr-compose.mjs up",
    "structurizr:down": "node scripts/local-structurizr-compose.mjs down",
    "start": "npm run build && node bin/collabmd.js",
    "start:local-plantuml": "npm run build && node bin/collabmd.js --local-plantuml",
    "start:local-structurizr": "npm run build && node bin/collabmd.js --local-structurizr",
    "start:prod": "node bin/collabmd.js",
    "test": "npm run test:guardrails && npm run test:unit && npm run test:integration:prebuilt && npm run test:browser && npm run test:e2e:prebuilt",
    "test:browser": "vitest run --config vitest.config.mjs --browser=chromium",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:prebuilt": "playwright test",
    "test:excalidraw:stress": "node scripts/run-excalidraw-reliability-stress.mjs",
    "test:guardrails": "node --test tests/node/guardrails/*.test.js",
    "test:integration": "npm run build && npm run test:integration:prebuilt",
    "test:integration:prebuilt": "node --test --test-force-exit --test-concurrency=2 tests/node/integration/*.test.js",
    "test:unit": "npm run build && node --test --test-force-exit tests/node/*.test.js",
    "tunnel": "node scripts/cloudflare-tunnel.mjs"
  },
  "keywords": [
    "markdown",
    "collaboration",
    "obsidian",
    "vault",
    "yjs",
    "mermaid",
    "cli"
  ],
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "dependencies": {
    "@excalidraw/fractional-indexing": "^0.18.0-214cd6e",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@turbodocx/html-to-docx": "^1.22.2",
    "archiver": "^8.0.0",
    "js-yaml": "^5.4.1",
    "lib0": "^0.2.117",
    "openid-client": "^6.8.8",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "@radix-ui/react-tabs": "1.1.13",
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "nanoid": "3.3.18",
    "axios": "1.18.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@embedpdf/snippet": "2.15.0",
    "@eslint/js": "^10.0.1",
    "@excalidraw/excalidraw": "0.18.0-214cd6e",
    "@playwright/test": "^1.63.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.1",
    "mermaid": "^11.17.2",
    "mermaid-formatter": "^0.3.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "y-codemirror.next": "^0.3.6",
    "y-websocket": "^3.1.0"
  }
}
